# =============================================================================
# Rising HelpDesk — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=RisingHelpDeskDB
MYSQL_USER=helpdesk
MYSQL_PASSWORD=helpdesk_password_change_me

# -----------------------------------------------------------------------------
# API Principal (RisingHelpdesk — porta 8001)
# -----------------------------------------------------------------------------
API_PORT=8001
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/RisingHelpDeskDB?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=helpdesk
SPRING_DATASOURCE_PASSWORD=helpdesk_password_change_me
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Gateway (Spring Cloud Gateway — porta 8080)
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
# URL interna da API principal acessível pelo Gateway dentro da rede Docker
API_INTERNAL_URL=http://api:8001

# -----------------------------------------------------------------------------
# Redis (cache distribuído — porta 6379)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Prometheus (coleta de métricas — porta 9090)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
# Endereço da API visto pelo Prometheus dentro da rede Docker
PROMETHEUS_TARGET=api:8001

# -----------------------------------------------------------------------------
# Grafana (dashboards — porta 3000)
# -----------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password_change_me
